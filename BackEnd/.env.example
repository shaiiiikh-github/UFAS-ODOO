# Copy this file to .env and adjust values for your environment.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sql
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urban_accounting

# --- Auth / JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Razorpay ---
# Get these from https://dashboard.razorpay.com/app/keys (test mode is fine for dev).
RAZORPAY_KEY_ID=rzp_test_TYIM0Zy3miXSsQ
RAZORPAY_KEY_SECRET=BVPRuwwckF3J371XDwD0ffCi
