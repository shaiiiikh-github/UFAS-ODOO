# Copy to `.env` and set to match your local PostgreSQL.
# The app builds the async DSN as:
#   postgresql+asyncpg://<USER>:<PASSWORD>@<SERVER>:<PORT>/<DB>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sql
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urban_accounting

# Change this in any real deployment.
SECRET_KEY=urban-furniture-dev-secret-change-me

# Frontend origins allowed by CORS (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
